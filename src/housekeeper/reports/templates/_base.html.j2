<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Housekeeper — {{ title }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 1200px; margin: 1.5rem auto; padding: 0 1rem; }
  h1 { margin-bottom: .25rem; }
  nav { margin: .5rem 0 1.5rem; padding: .5rem 0; border-bottom: 1px solid #8884; font-size: .9rem; }
  nav a { margin-right: .8rem; }
  table { border-collapse: collapse; width: 100%; margin: .75rem 0; }
  th, td { padding: .35rem .6rem; border: 1px solid #8884; text-align: left; vertical-align: top; }
  th { background: #8881; }
  code, .path { font-family: ui-monospace, monospace; font-size: .85em; word-break: break-all; }
  .facts { border-left: 3px solid #3a7; padding-left: .8rem; }
  .estimate { border-left: 3px solid #d90; padding-left: .8rem; }
  .warn { color: #b00; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .cards { display: flex; flex-wrap: wrap; gap: .6rem; }
  .card { border: 1px solid #8884; border-radius: 6px; padding: .5rem .8rem; min-width: 8rem; }
  .card b { font-size: 1.3rem; display: block; }
  .overflow { overflow-x: auto; }
</style>
</head>
<body>
<nav>
  <a href="summary.html">Summary</a>
  <a href="changes.html">Changes</a>
  <a href="coverage.html">Coverage</a>
  <a href="inventory.html">Inventory</a>
  <a href="exact_duplicates.html">Duplicates</a>
  <a href="directory_overlap.html">Overlap</a>
  <a href="document_versions.html">Doc versions</a>
  <a href="image_groups.html">Images</a>
  <a href="large_files.html">Large files</a>
  <a href="projects.html">Projects</a>
  <a href="errors.html">Errors</a>
</nav>
<h1>{{ title }}</h1>
{% block content %}{% endblock %}
<footer style="margin-top:2rem;color:#8888;font-size:.8rem">
  Facts and estimates are shown separately. Estimated reviewable bytes are <b>not</b> guaranteed
  reclaimable space. Housekeeper never permanently deletes files.
</footer>
</body>
</html>
